[node name="reboot_activity" type="Node2D" parent="MeshInstance2D" unique_id=811356171]
script = ExtResource("5_8hb6y")
computery_bullshit = "ldi 0d
str@t
brk
ldx
# ldi 10d 
str@q # store 10 in q
ldi 1d # shift in 1
ldi 1d # shift in 1
str@w # store 1 in w
str@e # store 1 in e

:top 
    ldr@e # shift in e [e]
    ldr@w # shift in w [e,w]
    add # add [e+w]
    ldr@w # shift in w [e+w,w]
    puh # push to stack <e+w> [w]
    pop # pop from stack [w,e+w]
    str@e # store w in e [e+w]
    str@w # store e+w in w []
    # print (w)
    brk
    ldr@w
    stx

    ldr@t # shift in t [t]
    ldi 1d
    add
    str@t
    ldr@t

    ldr@q # shift in q [e+w,q]
    lte # lte [0xff ? e+w <= q : 0x00]
    str@r # store 0xff ? e+w <= q : 0x00 in r []
    ldr@r # shift in r [r]
    not   # not [!r]
    ldi $top # [!r, :bottom]
    and # [res]
    puh # <res>
    ldr@r # <res> [r] 
    ldi $bottom # shift in :top <res> [r, :top]
    and # and <res> [rek]
    pop # [res, rek]
    or # [rel]
    stp # jump to :top ? e+w <= q : :bottom

:bottom
    cst
    ldi $bottom
    stp

include ./example/ink/irt.oct
include ./example/graphics/header.oct
:entry

ldi 0d # [0]
ldr@a # set a to 0 []

:trap
    cst # []

    # inefficient to do this but it's fast so who cares
    ldi .PPU_SWAP_INSTR # [.PPU_SWAP_INSTR]
    stx # []
    
    ldr@a # [a]
    # ldi 0d
    ldi .PPU_CHAR_INC_INSTR # [.PPU_CHAR_INC_INSTR, a]
    or # [.PPU_CHAR_INC_INSTR|a]
    stx # []

    ldr@a # [a]
    ldi 2d # [2, a]
    add # [a+2]
    ldi fx # [fx, a+2]
    and # [(a+2)&fx]
    ldi 8d # [8, (a+2)&fx]
    add # [(a+2)&fx+8]
    ldi 4d # [4, (a+2)&fx+8]
    lsh # [((a+2)&fx+8)<<4]
    ldi 2d # [2, ((a+2)&fx+8)<<4]
    add # [(((a+2)&fx+8)<<4)+2]
    str@j # []
    ldr@a # [a]
    ldi fx # [fx, a]
    and # [a&fx]
    ldr@j # [j, a&fx]
    or # [j|(a&fx)]
    ldi .PPU_PALLETTE_INSTR # [.PPU_PALLETTE_INSTR, j|(a&fx)]
    or # [j|(a&fx)|.PPU_PALLETTE_INSTR]
    stx # []

    ldr@a # [a]
    ldi 1d # [1, a]
    add # [1+a]
    ldi < .WIDTH .HEIGHT * # [fx, 1+a]
    mod
    str@a

    ldr@a # [a]
    # ldi 0d
    ldi .PPU_CHAR_INSTR # [.PPU_CHAR_INC_INSTR, a]
    or # [.PPU_CHAR_INC_INSTR|a]
    stx # []

    ldi $trap
    stp
"
